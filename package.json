{
  "name": "lets-learn-lms",
  "version": "1.0.0",
  "description": "Learning Management System with frontend and backend",
  "scripts": {
    "dev": "concurrently \"bun run dev:frontend\" \"bun run dev:backend\"",
    "dev:frontend": "cd frontend && bun run dev",
    "dev:backend": "cd backend && bun run start:dev",
    "start": "concurrently \"bun run start:frontend\" \"bun run start:backend\"",
    "start:frontend": "cd frontend && bun run start",
    "start:backend": "cd backend && bun run start",
    "build": "bun run build:frontend && bun run build:backend",
    "build:frontend": "cd frontend && bun run build",
    "build:backend": "cd backend && bun run build",
    "install": "bun run install:frontend && bun run install:backend",
    "install:frontend": "cd frontend && bun install",
    "install:backend": "cd backend && bun install",
    "test": "bun run test:backend && bun run test:frontend",
    "test:backend": "cd backend && bun run test",
    "test:frontend": "cd frontend && bun run test"
  },
  "keywords": [
    "lms",
    "learning",
    "management",
    "system",
    "nestjs",
    "react"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^8.2.0"
  }
}