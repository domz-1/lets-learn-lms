# This is an example environment file
# Copy this file to .env and update the values as needed

# For the backend service
BACKEND_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lets_learn_lms
BACKEND_DB_HOST=localhost
BACKEND_DB_PORT=5432
BACKEND_DB_NAME=lets_learn_lms
BACKEND_DB_USER=postgres
BACKEND_DB_PASSWORD=postgres
BACKEND_JWT_SECRET=your-super-secret-jwt-key
BACKEND_PORT=3000

# For the frontend service
FRONTEND_REACT_APP_API_URL=http://localhost:3000
FRONTEND_PORT=3001